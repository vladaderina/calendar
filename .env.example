# ── Supabase (fill in real values) ──────────────────────────────────────
# Get these from https://supabase.com/dashboard → project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Windows nginx Configuration ─────────────────────────────────────────
# Your server configuration
DOMAIN_NAME=lunxhome.tplinkdns.com
SECRET_ENDPOINT=luna-calendar-secure
SERVER_PORT=3000
EXTERNAL_PORT=443
SERVER_IP=78.29.33.110

# ── Security Configuration ──────────────────────────────────────────────
# Your home IP for IP whitelist
SECURITY_HOME_IP=78.29.33.110

# ── Optional: Let's Encrypt credentials (for win-acme) ───────────────
# Not required for self-signed certificates
# ACME_EMAIL=your-email@example.com

# ── Security Alerts (optional - Telegram notifications) ─────────────────
# Create bot: @BotFather, get token
# Get chat_id: https://api.telegram.org/bot<token>/getUpdates
SECURITY_ALERT_BOT_TOKEN=
SECURITY_ALERT_CHAT_ID=